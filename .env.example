# MatterMind Platform — Comprehensive Environment Configuration Blueprint
# Copy to `.env` and fill in values before deploying.

# ==========================================
# 1. BACKEND & GENERAL CONFIGURATION
# ==========================================
PROJECT_NAME="MatterMind API"
VERSION="1.0.0"
PORT=8000
SECRET_KEY="generate-secure-random-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# 2. DATABASE CONFIGURATION
# ==========================================
# SQLite for local development:
DATABASE_URL="sqlite:///./mattermind.db"
# PostgreSQL for production deployment:
# DATABASE_URL="postgresql://user:password@host:5432/mattermind_db"

# ==========================================
# 3. CORS & SECURITY
# ==========================================
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://mattermind.onrender.com"
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# ==========================================
# 4. FRONTEND CONFIGURATION (Vite)
# ==========================================
VITE_API_URL="http://localhost:8000"

# ==========================================
# 5. AI ENGINE CONFIGURATION
# ==========================================
MATTERMIND_AI_LLM_PROVIDER="openai"
MATTERMIND_AI_LLM_MODEL="gpt-4o-mini"
MATTERMIND_AI_LLM_API_KEY="your-openai-api-key-here"
MATTERMIND_AI_OCR_ENGINE="tesseract"
MATTERMIND_AI_SUMMARY_LENGTH=250

# ==========================================
# 6. BLOCKCHAIN CONFIGURATION
# ==========================================
HARDHAT_NETWORK="localhost"
ETH_RPC_URL="http://127.0.0.1:8545"
CONTRACT_ADDRESS=""
