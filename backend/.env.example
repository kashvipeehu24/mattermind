# Copy this file to `.env` and adjust the values for your environment.

# Application metadata
PROJECT_NAME=MatterMind API
VERSION=1.0.0

# Database connection string.
# SQLite (default, local development):
DATABASE_URL=sqlite:///./mattermind.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://mattermind:password@localhost:5432/mattermind

# JWT settings. Generate a strong random value for production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
